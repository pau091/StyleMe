# VARIABLES DE ENTORNO DE STYLEME
# -------------------------------
# 1. Copia este archivo y llama a la copia ".env" (sin ".example").
# 2. Llena los valores. El archivo .env NO se sube a GitHub (está en .gitignore).

# ---------- Base de datos (PostgreSQL + pgvector) ----------
POSTGRES_DB=styleme
POSTGRES_USER=styleme
POSTGRES_PASSWORD=cambia-esta-contrasena
POSTGRES_PORT=5432

# ---------- Gemini (embeddings y respuestas de Lía) ----------
# La clave se saca gratis en Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=pega-aqui-tu-clave
# (Opcional) Modelos, si quieres cambiarlos:
# GEMINI_MODELO=gemini-3.1-flash-lite
# GEMINI_MODELO_EMBEDDINGS=gemini-embedding-001

# ---------- Backend (Spring Boot) ----------
# Puerto del backend. Cámbialo si en tu computador ya está ocupado.
SERVER_PORT=8090

# Más variables (JWT, n8n) se agregan en las ramas que las necesiten.
